/*!
 * jquery.netcube.KIsearchV2.js
 * 2021/10/26
 * 機種名の検索機能を拡張する
 * KIsearchのHTML構造変更及び情報記録機能拡張
 *
 */
;(function($){
  $.fn.KISearch = function(options){
    var elem=this;
    var opts=$.extend({}, $.fn.KISearch.defaults, options);

    var guid=function(){
      var S4 = function() { return (((1+Math.random())*0x10000)|0).toString(16).substring(1); };
      return (S4()+S4()+"-"+S4()+"-"+S4()+"-"+S4()+"-"+S4()+S4()+S4());
    };

    var store={
      get:function(key){
        if(typeof localStorage == 'undefined') return;
        var v=localStorage.getItem(key);
        try{
          return JSON.parse(v);
        }catch(e){console.log(e);return null;}
      },
      set:function(key,val){
        if(typeof localStorage == 'undefined') return;
        localStorage.setItem(key,JSON.stringify(val));
      },
      remove:function(key){
        if(typeof localStorage == 'undefined') return;
        this._stack[key]=this.get(key);
        localStorage.removeItem(key);
      },
      _stack:{},
      undo:function(key){
        if(! this._stack[key]) return;
        this.set(key,this._stack[key]);
        this._stack[key]=null;
      }
    };

    var id_ki = guid();

    var container=$('<div>')
    .addClass( opts.class );

    //サーバに送信する場合はsendにappend
    //サーバに送信したくないものはelemにappendする
    var form=$('<form>')
    .attr({action:opts.cgiroot+'/'+opts.searchAPI,method:'get'})
    .addClass( opts.class + '-form' );

    $.fn.checkedBox = function( type,name,text,value,checked ){
      var _id = guid();
      var c = $('<input>')
              .attr({type:type,name:name,value:value,id:_id})
              .on('change',(e)=>{
                var o=store.get(opts.class + '-ps');
                if(! o) o={};
                o[$(e.currentTarget).val()]=$(e.currentTarget).prop('checked');
                store.set(opts.class + '-ps',o)
                $(window).trigger('init');
              })
              .prop('checked',checked);
      var l = $('<label>').attr({for:_id}).addClass(type).text(text);
      this.append(c);
      this.append(l);
      return this;
    };


    var header = $('<div>').addClass(opts.class + '-header');
    
    var psw=$('<div>').addClass('nc-navi-p').addClass('nc-navi-s');

    var ps=$('<div>')
    .addClass(opts.class + '-ps')
    ps.checkedBox('checkbox','cd_ps[]','パチンコ',1,true);
    ps.checkedBox('checkbox','cd_ps[]','スロット',2,true);
    psw.append(ps);
    header.append(psw);

    var undo=$('<div>')
    .addClass( opts.class + '-btn' )
    .addClass( opts.class + '-btn-undo' )
    .append(
       $('<button>').attr({'type':'button'}).on('click',(e)=>{
         store.undo(opts.class + '-ps');
         store.undo(opts.class + '-kisyu');
         $(window).trigger('init');
       })
    );
    header.append(undo);

    var reset=$('<div>')
    .addClass( opts.class + '-btn' )
    .addClass( opts.class + '-btn-reset' )
    .append(
       $('<button>').attr({'type':'button'}).on('click',(e)=>{
         store.remove(opts.class + '-ps');
         store.remove(opts.class + '-kisyu');

//         $('#'+id_ki).focus();
         $(window).trigger('init');

         return false;
       })
    );
    header.append(reset);

    form.append(header);


    var filter=$('<div>')
    .addClass( opts.class + '-kisyu');
    filter.append(
      $('<input>')
     .attr({id:id_ki,name:'nmk_kisyu',placeholder:opts.placeholder})
     .on('input change',(e)=>{
       var v=$(e.currentTarget).val();
       undo.hide();

       if(v){
         reset.show();
       }else{
         reset.hide();

         if( Object.keys(store._stack).length )
           undo.show();
       }
       store.set(opts.class + '-kisyu',v);
     })
    );

    var submit=$('<div>')
    .addClass( opts.class + '-btn')
    .addClass( opts.class + '-btn-submit')
    .append( $('<button>').attr({'type':'submit'}) );
    filter.append(submit);

    form.append(filter);


    form.submit(function(event){
      event.preventDefault();

      if(! $('#'+id_ki).val() ){
        elem.triggerHandler('error','機種名を入力してください');
        return false;
      }
      var q=$(this).serialize();
      $.ajax({
        url:$(this).attr('action')
       ,type:$(this).attr('method')
       ,data:q
      })
      .done(function(json){
        if(json && json.ki && json.ki.length){
          location.href=opts.cgiroot+'/'+opts.redirectAPI+'?'+q;
        }else if(json && json.redirect_captcha){
          location.href=json.redirect_captcha;
        }else{
          elem.triggerHandler('error','機種はありません');
        }
      })
      .fail(function(jqXHR){
        message = jqXHR.statusText + '(' + jqXHR.status + ')';
        elem.triggerHandler('error',message);
      });
      return false;
    });

    container.append(form);
    elem.append(container);


    //初期状態復元
    $(window).on('init',(event)=>{

      //PS区分:デフォルトtrue
      try{
        var v=store.get(opts.class + '-ps');
        $(elem).find("[name='cd_ps[]']").each(function(){
          try{
            $(this).prop('checked',v[$(this).val()]);
          }catch(e){$(this).prop('checked',true);console.log(e);}
        });
      }catch(e){}

      //機種名:デフォルト空
      try{
        var v=store.get(opts.class + '-kisyu');
        $('#'+id_ki).val( store.get(opts.class + '-kisyu') );
      }catch(e){$('#'+id_ki).val('');console.log(e);} 

      //PSどちらかが非表示の場合
      //PS条件の記憶を消去
      try{
        var css = getComputedStyle(psw.get(0));
        if(css.getPropertyValue('display') == 'none'){
          store.remove(opts.class + '-ps');
        }
      }catch(e){}

      //消去ボタンとアンドゥボタンの表示制御
      $('#'+id_ki).trigger('input');
    });

    window.addEventListener('DOMContentLoaded',(event)=>{
      reset.hide();
      undo.hide();
      $(window).trigger('init');
    });

    return this;
  };
  
  $.fn.KISearch.defaults={
     cgiroot:'cgi-bin'
    ,searchAPI:'nc-m03-003.php'
    ,redirectAPI:'nc-v03-003.php'
    ,class:'nc-ki-search'
    ,placeholder:'機種名から台を探す'
  };
})(jQuery);
