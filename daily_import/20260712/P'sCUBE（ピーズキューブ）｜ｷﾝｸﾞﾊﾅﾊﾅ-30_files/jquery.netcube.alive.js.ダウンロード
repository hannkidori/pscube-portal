;(function($) {
  var _callback = function(){
    try{
      parent.postMessage('alive', "*");
    }catch(e){
      ;
    }
  };
window.addEventListener('click', _callback);
window.addEventListener('movestart', _callback);
window.addEventListener('load', _callback);
})(jQuery);
