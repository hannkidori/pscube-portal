/*!
 * jquery.netcube.DAsearchV2.js
 * 2021/10/26
 * 台番号検索機能を拡張する
 * DAsearchのHTML構造変更及び情報記録機能拡張
 *
 */
;(function($){
  $.fn.DASearch = function(options){
    var elem=this;
    var opts=$.extend({}, $.fn.DASearch.defaults, options);

    var guid=function(){
      var S4 = function() { return (((1+Math.random())*0x10000)|0).toString(16).substring(1); };
      return (S4()+S4()+"-"+S4()+"-"+S4()+"-"+S4()+"-"+S4()+S4()+S4());
    };

    var store={
      get:function(key){
        if(typeof localStorage == 'undefined') return;
        var v=localStorage.getItem(key);
        try{
          return JSON.parse(v);
        }catch(e){console.log(e);return null;}
      },
      set:function(key,val){
        if(typeof localStorage == 'undefined') return;
        localStorage.setItem(key,JSON.stringify(val));
      },
      remove:function(key){
        if(typeof localStorage == 'undefined') return;
        this._stack[key]=this.get(key);
        localStorage.removeItem(key);
      },
      _stack:{},
      undo:function(key){
        if(! this._stack[key]) return;
        this.set(key,this._stack[key]);
        this._stack[key]=null;
      }
    };

    var id_da=guid();

    var container=$('<div>')
    .addClass( opts.class );

    //サーバに送信する場合はsendにappend
    //サーバに送信したくないものはelemにappendする
    var form=$('<form>')
    .attr({action:opts.cgiroot+'/'+opts.searchAPI,method:'get'})
    .addClass( opts.class + '-form' );


    var header = $('<div>').addClass(opts.class + '-header');

    var undo=$('<div>')
    .addClass( opts.class + '-btn' )
    .addClass( opts.class + '-btn-undo' )
    .append(
       $('<button>').attr({'type':'button'}).on('click',(e)=>{
         store.undo(opts.class + '-dai');
         $(window).trigger('init');
       })
    );
    header.append(undo);

    var reset=$('<div>')
    .addClass( opts.class + '-btn' )
    .addClass( opts.class + '-btn-reset' )
    .append(
       $('<button>').attr({'type':'button'}).on('click',(e)=>{
         store.remove(opts.class + '-dai');

//         $('#'+id_da).focus();
         $(window).trigger('init');
         return false;
       })
    );
    header.append(reset);

    form.append(header);


    var filter=$('<div>')
    .addClass( opts.class + '-dai');

    filter.append(
      $('<input>')
     .attr({id:id_da,name:'cd_dai',placeholder:opts.placeholder,type:'tel',min:1})
     .on('input change',(e)=>{
       var v=$(e.currentTarget).val();
       undo.hide();

       if(v){
         reset.show();
       }else{
         reset.hide();

         if( Object.keys(store._stack).length )
           undo.show();
       }
       store.set(opts.class + '-dai',v);
      })
    );

    var submit=$('<div>')
    .addClass( opts.class + '-btn')
    .addClass( opts.class + '-btn-submit')
    .append($('<button>').attr({'type':'submit'}));

    filter.append(submit);

    form.append(filter);

    form.submit(function(event){
      event.preventDefault();
      $.ajax({
        url:$(this).attr('action')
       ,type:$(this).attr('method')
       ,data:$(this).serialize()
      })
      .done(function(json){
        if(json && json.isOK){
          location.href=opts.cgiroot+'/'+json.redirect;
        }else if(json && json.redirect_captcha){
          location.href=json.redirect_captcha;
        }else{
          elem.triggerHandler('error',json.message);
        }
      })
      .fail(function(jqXHR){
        message = jqXHR.statusText + '(' + jqXHR.status + ')';
        elem.triggerHandler('error',message);
      });
      return false;
    });

    container.append(form);
    elem.append(container);


    //初期状態復元
    $(window).on('init',(event)=>{

      //台番号:デフォルト空
      try{
        $('#'+id_da).val( store.get(opts.class + '-dai') );
      }catch(e){$('#'+id_da).val('');console.log(e);}

      //消去ボタンとアンドゥボタンの表示制御
      $('#'+id_da).trigger('input');
    });

    window.addEventListener('DOMContentLoaded',(event)=>{
      reset.hide();
      undo.hide();
      $(window).trigger('init');
    });

    return this;
  };

  $.fn.DASearch.defaults={
     cgiroot:'cgi-bin'
    ,searchAPI:'nc-m06-002.php'
    ,class:'nc-da-search'
    ,placeholder:'台番号から台を探す'
  };
})(jQuery);
