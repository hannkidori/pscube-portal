		if( json.page < 2 ){
			$("#tblHISTb").empty();
		}
console.log(json);
		if( json.HistCount < 1 ){
			/* レコードが存在しない場合 */
			/* 表を消してエラーメッセージを表示する */
			api.notfound( $("#tblHISTh img") );
			$("#tblHIST").hide();
			$("#tblHISTh").show();
		}else{
			/* レコードが存在する場合 */
			/* 表示を表示してエラーメッセージを非表示にする */
			$("#tblHIST").show();
			$("#tblHISTh").hide();
			/* 追加分レコードが存在する場合 */
			if( json.Hist.length ){
				tbl.append(
                                    $( $("#TmplHIST").render(json.Hist) )
                                    .fadeIn(1000)
                                );
			}
		}

		/* 追加読み込み用のボタン制御 */
		$("#tblHISTm").off('click');
		if( json.page < json.pageMax && json.pageMax > 1 ){
			$("#tblHISTm")
			.on('click', function(){
				self._page = json.page + 1;
				self.show(self._cd_dai, self._YMD_biz,false)
				.progress(function(){
api.loader_object().loaderShow();
				})
				.then(function(){
api.loader_object().loaderHide();
/* ページの高さが変わるのでDMM向けに高さ変更の通知 */
///$(window).trigger('refreshDMM');
				});
			})
			.show();
		}else{
			$("#tblHISTm").hide();
		}
                return api.deferred.resolve();
