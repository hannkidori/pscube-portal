$.work = function(args)
{
	var deferred = $.Deferred(function(dfd){
		if(window.Worker){
			var worker = new Worker(args.file);
			worker.onmessage = function(event){
				dfd.resolve(event.data);
			};
			worker.onerror = function(event){
				dfd.reject(event);
			};
			worker.postMessage(args.args);
		}
	});
	return deferred.promise();
};

$.fn.center = function()
{
	var w = $(window);
	this.css({
		'position':'absolute',
		'top':Math.abs(((w.height() - this.outerHeight()) / 2) + w.scrollTop()),
		'left':Math.abs(((w.width() - this.outerWidth()) / 2) + w.scrollLeft())
	});
	return this;
};

$.fn.loaderShow = function()
{
	$('.nc-main').css({'opacity':0.3});
	return this.center().show();
}

$.fn.loaderHide = function()
{
	$('.nc-main').css({'opacity':1});
	return this.hide();
}

