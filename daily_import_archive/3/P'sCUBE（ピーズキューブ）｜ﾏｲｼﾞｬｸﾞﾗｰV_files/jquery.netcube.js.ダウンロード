            chart.addListener('rendered', function() {
                if (scrollNecessity) {
                    var dtEnd = graphData.src.datas.pop().date;
//データ表示期間
var dtStart = dtEnd - 48*3600*1000;
                    var startDate = new Date(dtStart);
                    var endDate = new Date(dtEnd);
