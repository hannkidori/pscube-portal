        _model:function()
        {
//            return "/h/" + this.uid + "/cgi-bin/" + this.model;
            return this.model;
        },
        _zoom:1.0,
        fitText:function(zoom)
        {
            if( zoom ){
                api._zoom = zoom;
            }
            $(".fit-text").fitText( api._zoom );
//$(window).trigger('refreshDMM');
            return false;
        },
        toPx:function(em) {
            var px = $('.fit-text').css('font-size').replace('px','');
            return px * em;
        },
	loader_object:function(){ return $('.nc-loader'); },
        deferred:null,
        notfound:function(jq_img)
        {
            jq_img.attr("src","/images/00/notfound.png")
                  .addClass('nc-notfound-img')
                  .next('.nc-notfound')
                  .show();
            return false;
        },
        notify:function( message, isStickey ){
	    var d = new $.Deferred();
            ios.notify({ title: 'INFORMATION(お知らせ)', message:message, sticky:isStickey, click:function(){$(this).fadeOut(500);} })
            .then(function(){
	        return d.resolve();
	    });
            return d.promise();
        },
	jqXHROnError:function(jqXHR){
	    //jqXHR:statusText, responseText, status
	    var isReload = false;
	    var message;
	    if( this.loader_object() )
	        this.loader_object().loaderHide();
	    if(! jqXHR ){
		message = '想定外のエラーが発生しました。';
	    }else{
//console.log(jqXHR);
		//エラーメッセージ
		switch( jqXHR.status )
		{
		case 0:
			if( jqXHR.statusText == 'timeout' ){
				message = '一定時間内に応答がなかったため、接続を切断しました。';
			}
			break;
		case 200:
		case 406:
			//http(200)でエラーが発生する場合
			//jsonではなくWebサーバ側のエラーHTMLが返ってきたため。よってブラウザの再リロードでエラー画面を再表示する
//console.log(jqXHR);
			message = 'エラーが発生しました。お手数ですが一度トップページに戻ってからご覧ください。';
			break;
		case 404:
			message = 'ページが見つかりません。Wi-Fiご利用中の場合は接続が切断された可能性があります。';
			break
		case 503:
			message = jqXHR.statusText;
			break;
		default:
			message = jqXHR.statusText + '(' + jqXHR.status + ')';
			break;
		}
	    }
	    this.notify( message )
	    .then(function(){
	        if( isReload && api.documentRoot ){
                    location.href = api.documentRoot+'/';
                }
	    });
	    return false;
	},
        scrollTop:function()
        {
            var d = new $.Deferred();
            if(! $(window).scrollTop() ){
                return d.resolve();
            }
            d.notify();
            $('html, body').velocity("scroll",300,function(){return d.resolve()});
            return d.promise();
        } 
};
