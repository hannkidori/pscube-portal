                );

                if($("#tblHISTb tr.hide").length){
                  $("#tblHISTm").show();
                }

                $("#tblHISTm").off('click').on('click',function(){
                  $("#tblHISTb tr.hide").each((index,val)=>{
                    if(index > json.limit) return;
                    $(val).removeClass('hide').addClass('show');
                  });

                  //全て表示したらmoreボタンをOFF
                  if($("#tblHISTb tr.hide").length){
                    $("#tblHISTm").show();
