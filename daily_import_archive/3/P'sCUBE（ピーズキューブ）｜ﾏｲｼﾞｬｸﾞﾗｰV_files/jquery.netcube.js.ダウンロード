        renderCharts: function(graphDatas) {
                var self = this;
                //チャートエリア表示イベント伝播
                var area =  $('#divCHART');
                area.off('refresh').on('refresh',function(){
                    area.find('.nc-svg-transmit-panel').each(function(index){
                        var svg = $(this);
                        setTimeout(function(){
                            svg.trigger('show');
                        },index*100);
                    });
//                    return false;
                });
                //各チャート毎のイベント
		$.each(graphDatas, function(i, value) {
                        var svg = $('#' + value.id);
                        var root = svg.parent().parent();
                        var container = root.find('.nc-notfound-panel');
root.find('.nc-data-panel').css({visibility:"hidden"});
                        self._showNoData(container,'ロード中');
                        var isError = false;
                        if(! value.src){
                            isError = true;
                        }
                        if(! value.src.datas){
                            isError = true;
                        }
                        if(! value.src.datas.length){
                            isError = true;
                        }
                        if(isError){
                            self._showNoData(container,'データはありません。');
                            return true;
                        }

                        var scrollNecessity = value.src.scrollbar;

                       	svg.off('show').on('show', function(){
                            var ro = svg.parent().parent();
                            var conA = ro.find('.nc-data-panel');
                            var conB = ro.find('.nc-notfound-panel');
                            conB.parent().removeClass('nc-relative').addClass('nc-absolute');

                            svg.trigger('invalidate');

                            //凡例
                            legend = conA.find('.nc-legend');
                            if(scrollNecessity){
                                legend.removeClass('nc-svglegend-1').addClass('nc-svglegend-2');
                            }else{
                                legend.removeClass('nc-svglegend-2').addClass('nc-svglegend-1');
                            }
                            legend.show();

                            if (scrollNecessity) {
                                //透過パネル削除してタップ動作を有効化
                                svg.removeClass('nc-svg-transmit-panel');
                                svg.on('movestart', function(e){ e.stopPropagation(); });
                                svg.on('moveend', function(e){ e.stopPropagation(); });
                                svg.on('swipeleft', function(e){ e.stopPropagation(); });
                                svg.on('swiperight', function(e){ e.stopPropagation(); });
                            }

                            conA.css({visibility:"visible"}).hide();
                            conB.velocity("fadeOut",500,function(){ $(this).hide(); });
                            conA.show();
                            return false;
                        });

                        //グラフ再計算及び再描画
