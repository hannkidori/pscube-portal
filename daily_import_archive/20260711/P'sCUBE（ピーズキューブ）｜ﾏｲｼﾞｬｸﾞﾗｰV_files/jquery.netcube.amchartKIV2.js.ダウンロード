<li id="li-{{:amD.cd_dai}}" class="li">
  <div style="margin:.5em;{{:graph}}">
    <a href="{{:opts.href.url}}?{{:~cgiParam(opts)}}#{{:amD.YMD_biz}}" style="position:relative;display:block;margin-left:.5em;">
