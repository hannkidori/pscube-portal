/*!
 * jquery.netcube.amchartKIV2.js
 * 2021/07/01
 * amChartを用いた機種毎全台スランプグラフVer2
 * スランプグラフに加え、基礎データを表示する
 * jquery.netcube.amchartKI.jsをベースに作成
 *
 */
;(function($){
  $.fn.AmChartKIV2=function(options){
    var opts=$.extend(true, $.fn.AmChartKIV2.defaults, options);
    var elem=this;
    elem.css({overflow:"hidden"});
    elem.addClass(opts.class);
    elem.empty();

    var guid=function(){
      var S4 = function() { return (((1+Math.random())*0x10000)|0).toString(16).substring(1); };
      return (S4()+S4()+"-"+S4()+"-"+S4()+"-"+S4()+"-"+S4()+S4()+S4());
    };

    var cgi_param={
      nmk_kisyu:opts.nmk_kisyu
     ,YMD_biz:opts.YMD_biz
     ,bai:opts.bai
     ,autoRender:opts.autoRender
     ,apikey:opts.apikey
     ,_i:opts._i
     ,_t:opts._t
    };

    var cached={
      json:''
     ,inviewTimer:null
    };

    opts.graph = $(elem).attr('data-graph');

    var id=guid();
    var ul=$('<ul>').attr({id:id});
    var className = opts.class+'-ul';
    ul.css({margin:0,padding:0}).addClass(className);
    elem.append($(tmpStyle).render({class:className}));
    elem.append(ul);

    //データ取得
    elem.off('refresh').on('refresh',function(){
      var d = new $.Deferred();
      d.notify();
      $.ajax({ url:opts.api
              ,data:cgi_param
              ,dataType:'json'
      }).done(function(json,status,jqXHR){
//console.log(json);
        cached.json=json;
        d.resolve();
        elem.triggerHandler('refreshed',json);
      }).fail(function(jqXHR, statusText){
        d.reject(jqXHR);
      }).always(function(){
        ;
      });
      return d.promise();
    });

    //再描画
    elem.off('render').on('render',function(e,params){
      if(! cached.json.amchart) return;
      var cloned = Object.create(cached.json.amchart);
      for(var i=0;i<cloned.dataProvider.length;i++){
        try{
          cloned.dataProvider[i].rows.map((row)=>{
            cloned.dataProvider[i][row.k] = row.v;
          });
        }catch(e){}
      }

      if(params && params.order){
        var order = params.order;
        if(order.k){
          if(! order.v) order.v=1;
//console.log(order);
          if(order.v > 0 ){
            cloned.dataProvider.sort((a,b)=>{
              if(a[order.k] < b[order.k]) return -1;
              if(a[order.k] > b[order.k]) return 1;
              if(a.cd_dai < b.cd_dai) return -1;
              if(a.cd_dai > b.cd_dai) return 1;
              return 0;
            });
          }else{
            cloned.dataProvider.sort((a,b)=>{
              if(a[order.k] < b[order.k]) return 1;
              if(a[order.k] > b[order.k]) return -1;
              if(a.cd_dai < b.cd_dai) return 1;
              if(a.cd_dai > b.cd_dai) return -1;
              return 0;
            });
          }
        }
      }

      ul.empty();
//alert(cloned.dataProvider.length);
//      if(! cloned.dataProvider.length) return;

      //初回表示
      var minRows = 0;
      try{
        minRows = params.minRows && params.minRows > 0 ? params.minRows : opts.minRows;
      }catch(e){
        minRows = opts.minRows;
      }
      minRows = Math.min(parseInt(minRows),cloned.dataProvider.length);
//console.log("MINROWS:"+minRows);
      for(var i=0;i<minRows;i++){
        appendAmChart(cloned,i);
      }
elem.triggerHandler('beforeAppend');

      //Inviewイベント
      clearTimeout(cached.inviewTimer);

      elem.off('inview').on('inview','li:last-child',function(event,isInView,visibleX,visibleY){
        /* inviwイベントが発火してからn秒後に読み込み開始 */
        //if(isInView && visibleY=='both'){
        if(isInView){
          /* リストの末尾に到達した場合は新たなチャートを生成する */
          cached.inviewTimer=setTimeout(function(){
            var i = ul.find('li').length;
            //全てのliが出尽くした場合はinviewイベントを発火しないようにする
            if( cloned.dataProvider.length - 1 < i ){
              elem.off('inview');
              return;
            }
            //指定数増分毎にレンダリング
            for(var j=0;j<opts.display;j++){
              appendAmChart(cloned,i+j);
            }
elem.triggerHandler('afterAppend');
          },10);
        }else{
          /*
             inview発火条件が解除された場合
             読み込みがキャンセルされたと判断しタイマーを無効化
          */
          clearTimeout(cached.inviewTimer);
        }
      });
    });

    //dataList
    ul.on('click touchstart','tr',(e)=>{
      var t=$(e.currentTarget);
      ul.find('.selected').removeClass('selected');
      var key = t.attr('data-key');
      $('[data-key="'+key+'"]').addClass('selected');
      ul.data('selected',key);
    });
    ul.on('clickAt','tr',(e)=>{
      var t=$(e.currentTarget);
      t.click();
      var tbl = t.parents('.tbl');
      var cont = t.parents('.cont');
      var index = t.index();
      var contH=cont.height();
      var y = t.offset().top - tbl.offset().top;
      var rowH = t.height();
//      var pos = cont.scrollTop();
//console.log("#1#"+contH);
//console.log("#2#"+t.offset().top);
//console.log("#3#"+tbl.offset().top);
//console.log("#4#"+rowH);
//console.log("#5#"+y);

      var p=Math.floor((y+rowH)/contH);
      var q=(y+rowH)%contH;

      cont.animate({scrollTop:contH*p},100);
    });

    //AmChart
    var appendAmChart=function(amchart,index){

      try{

        if(amchart.dataProvider.length - 1 < index) return;

        var amC=amchart.c;
        var amG=amchart.g;
        var amXA=amchart.xAxis;
        var amYA=amchart.yAxis;
        var amD=amchart.dataProvider[index];

//個別スタイルがあれば上書き
if( amD.amchart ){
  if( amD.amchart.xAxis ) $.extend(true,amXA,amD.amchart.xAxis);
  if( amD.amchart.yAxis ) $.extend(true,amYA,amD.amchart.yAxis);
}

//console.log(amD);

        if(opts.href.url){
          opts.href.param.cd_dai=amD.cd_dai;
        }

        ul.append( $(tmpGrid).render({
            amD:amD
           ,opts:opts
          },{
            cgiParam:function(opts){
              return $.param(opts.href.param)
            }
          })
        );
//elem.triggerHandler('afterAppend');

        var li = $('#li-'+amD.cd_dai);
        var chartId = 'ca-'+amD.cd_dai;
        var c=new AmCharts.AmXYChart();

        var sc = $('#sc-'+amD.cd_dai);
        sc.on('scroll',(e)=>{
          var top = $(e.target).scrollTop();
          ul.data('scrollTop',top);
          ul.find('.cont').scrollTop(top);
        });

        //選択状態の復元
        //選択行
        var key = ul.data('selected');
        if(key){
          $('[data-key="'+key+'"]').addClass('selected');
        }else{
          li.find('.tbl tr:first-child').addClass('selected');
        }
        //スクロール位置
        var top = parseInt(ul.data('scrollTop'));
        li.find('.cont').scrollTop(top);

        c.dataProvider=amD.item;
        c.fontFamily='monospace';
        c.autoMargins=false;

        c.marginLeft=amC.marginLeft;
        c.marginRight=amC.marginRight;
        c.marginTop=amC.marginTop;
        c.marginBottom=amC.marginBottom;
        c.borderAlpha=0;
c.fontSize=9;
        c.backgroundAlpha=amC.backgroundAlpha;

        //c.width=li.width();
        //c.height=li.height();
//console.log(ul.width());
//console.log(li.width());

        var g=new AmCharts.AmGraph();
        g.xField=amG.xField;
        g.yField=amG.yField;
        g.lineColor=amG.lineColor;
        g.lineThickness=amG.lineThickness;
        g.connect=false;
        c.addGraph(g);

        xAxis=new AmCharts.ValueAxis();
        xAxis.id='x';
        xAxis.position='bottom';
        xAxis.axisAlpha=0;
        xAxis.strictMinMax=true;
//        xAxis.gridAlpha=amXA.grid ? 1:0;
        xAxis.labelsEnabled=amXA.label;
        xAxis.maximum=amXA.maximum;
        xAxis.minimum=amXA.minimum;
        xAxis.autoGridCount=true;
        if(amXA.gridCount){
          xAxis.autoGridCount=false;
          xAxis.gridCount=amXA.gridCount;
        }

        c.addValueAxis(xAxis);


        yAxis=new AmCharts.ValueAxis();
        yAxis.id='y';
        yAxis.position='left';
        yAxis.axisAlpha=0;
        yAxis.strictMinMax=true;
//        yAxis.gridAlpha=amYA.grid ? 1:0;

        yAxis.labelsEnabled=amYA.label;
        yAxis.minimum=amYA.minimum;
        yAxis.maximum=amYA.maximum;
        yAxis.autoGridCount=true;
        if(amYA.gridCount){
          yAxis.autoGridCount=false;
          yAxis.gridCount=amYA.gridCount;
        }
        c.addValueAxis(yAxis);

        //軸を目一杯使う
        xAxis.strictMinMax=true;
        yAxis.strictMinMax=true;

        //X軸スタイル
        xAxis.gridAlpha=0;
        xAxis.tickLength=0;
        xAxis.gridThickness=0;
        xAxis.autoGridCount=false;
        xAxis.gridCount=0;
xAxis.zeroGridAlpha=1;
        xAxis.labelFunction = function(value,valueText,valueAxis){
          return "";
        };

        if(amXA.visibility){
          xAxis.gridAlpha=amXA.zero.lineAlpha;
          xAxis.gridColor=amXA.zero.lineColor;
//          xAxis.gridThickness=amXA.zero.lineThickness;
          xAxis.dashLength=amXA.zero.dashLength;
        }

        if(amXA.grid){
          xAxis.color=amXA.grid.color;
          xAxis.fontSize=amXA.grid.fontSize;
          xAxis.labelOffset=amXA.grid.labelOffset;
        }


        //Y軸スタイル
        yAxis.gridAlpha=0;
        yAxis.tickLength=0;
        yAxis.gridThickness=0;
        yAxis.autoGridCount=false;
        yAxis.gridCount=0;
        yAxis.labelFunction = function(value,valueText,valueAxis){
          return "";
        };

        if(amYA.visibility){
          yAxis.gridAlpha=amYA.zero.lineAlpha;
          yAxis.gridColor=amYA.zero.lineColor;
//          yAxis.gridThickness=amYA.zero.lineThickness;
          yAxis.dashLength=amYA.zero.dashLength;
        }


        if(amYA.grid){
          yAxis.color=amYA.grid.color;
          yAxis.fontSize=amYA.grid.fontSize;
          yAxis.labelOffset=amYA.grid.labelOffset;
        }

        //軸本数算出用
        //limit:上限
        //tick:軸本数
        //ただし最大値は除外しているので実質tick-1本のリストを返却する
        //roundMode 0:切り上げ0に丸める 1:切り上げ0,5に丸める
        var guideValues = (limit,tick,roundMode) => {
          var values = [];
//console.log("##INPUT##"+limit);
          if(limit > 0){
            var _increment=parseInt(limit/tick);    //増分値
            var digit=Math.abs(_increment).toString().length; //増分値の桁数
            var maxDigit = Math.abs(limit).toString().length; //上限桁数

            //最大値桁数は4桁を最低値とする
            if(maxDigit < 4) maxDigit=4;

            //増分値補正
            //基本的に最大値桁数-1桁目で補正する
            var digit = maxDigit-1;

            //増分値補正
            //最大値を元に補正処理を行う
            //上位2桁分から切り上げて0、もしくは5に丸める
            var unit=10**digit;
            var _step=_increment/unit;
            var increment10=Math.ceil(_step)*unit;
            var increment5=(Math.round(_step*2)/2)*unit;
            //5切り上げの場合は百の位は出さない
            if(increment5.toString().length<4) increment5 = increment10;

            var stepValues = [increment10,increment5];
//console.warn(stepValues);

            //0と上限値一致の数値は除外
            var total=0;
            while(total<limit){
              if(total !=limit && total !=0){
                values.push(total);
              }
              total+=stepValues[roundMode];
            }

//console.log("##増分##"+_increment);
//console.log("##桁数##"+digit);
//console.log("##桁数MAX##"+maxDigit);
//console.log("##補正単位##"+unit);
//console.log("##補正10##"+increment10);
//console.log("##補正5##"+increment5);
//console.log("##増分値##"+stepValues[roundMode]);
//console.log(values);
          }else if(limit < 0){
            var _values = guideValues(Math.abs(limit),tick,roundMode);
            values = guideValues(Math.abs(limit),tick,roundMode).map((x)=>{
              return -1*x;
            });
//console.log(values);
          }
          return values;
        };

        var addGuX = (value)=>{
          var gu=new AmCharts.Guide();
          gu.value=value;
          gu.above=true;
          gu.lineAlpha=0;

          //グリッド表示有無
          if(amXA.grid){
            gu.lineThickness=amXA.grid.lineThickness;
            gu.lineColor=amXA.grid.lineColor;
            gu.lineAlpha=amXA.grid.lineAlpha;
            gu.dashLength=amXA.grid.dashLength;
          }

          //ラベル表示有無
          if(amXA.label) gu.label=value;

          xAxis.addGuide(gu);
        };

        var addGuY = (value)=>{
          var gu=new AmCharts.Guide();
          gu.value=value;
          gu.above=true;
          gu.lineAlpha=0;

          //グリッド表示有無
          if(amYA.grid){
            gu.lineThickness=amYA.grid.lineThickness;
            gu.lineColor=amYA.grid.lineColor;
            gu.lineAlpha=amYA.grid.lineAlpha;
            gu.dashLength=amYA.grid.dashLength;
          }

          //ラベル表示有無
          if(amYA.label) gu.label=value;

          yAxis.addGuide(gu);
        };

        //X軸
        var val;
        try{
          val = amD.amchart.xAxis.maximum;
        }catch(e){
          val = amXA.maximum;
        }
        guideValues(val,amXA.gridCount,1).forEach((v,i)=>{
          addGuX(v);
        });

        //Y軸
        var max;
        var min;
        try{
          max = amD.amchart.yAxis.maximum;
        }catch(e){
          max = amYA.maximum;
        }
        try{
          min = amD.amchart.yAxis.minimum;
        }catch(e){
          min = amYA.minimum;
        }
        val = Math.max(Math.abs(max),Math.abs(min));

        //Y軸：プラス
        guideValues(val,amYA.gridCount,1).forEach((v,i)=>{
          addGuY(v);
        });
        //Y軸：マイナス
        guideValues(-1*val,amYA.gridCount,1).forEach((v,i)=>{
          addGuY(v);
        });

        c.write( chartId );

      }catch(e){
console.log(e);
      }
    };

    //データ未受信=初回読み込み
    if(! cached.json){
      //データ取得が完了したらチャートを挿入する
      elem
      .triggerHandler('refresh')
      .then(function(){
//console.log(cached.json);
         if(opts.autoRender)
           elem.triggerHandler('render',{order:{k:'cd_dai',v:1}});
      });
    }

  };

  $.fn.AmChartKIV2.defaults={
     class:'nc-amchart-ki'
    ,href:{url:'nc-v06-001.php',param:{cd_dai:''}}
    ,nmk_kisyu:''
    ,YMD_biz:''
    ,display:6   //読み込み時分割表示件数
    ,minRows:6   //読み込み開始時の初回表示件数
    ,autoRender:true //読み込み完了後に自動レンダリングするか否か
    ,api:'nc-m05-009.php'
  };

